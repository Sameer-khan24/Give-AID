@{
    Layout = "~/Views/Shared/User_Layout.cshtml";
}

<style>

    .hero {
        background: linear-gradient(135deg,#2563EB,#10B981);
        color: white;
        padding: 40px;
        border-radius: 20px;
        margin-bottom: 25px;
        box-shadow: 0 10px 25px rgba(0,0,0,.15);
    }

        .hero h1 {
            font-size: 42px;
            margin-bottom: 10px;
        }

        .hero p {
            font-size: 18px;
            opacity: .9;
        }

    .cards {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(250px,1fr));
        gap: 20px;
        margin-top: 25px;
    }

    .card {
        background: white;
        padding: 25px;
        border-radius: 18px;
        box-shadow: 0 5px 20px rgba(0,0,0,.08);
        transition: .3s;
    }

        .card:hover {
            transform: translateY(-6px);
        }

    .card-title {
        color: #64748B;
        font-size: 15px;
        margin-bottom: 10px;
    }

    .card-value {
        font-size: 34px;
        font-weight: bold;
        color: #0F172A;
    }

    .actions {
        margin-top: 30px;
        display: flex;
        gap: 15px;
        flex-wrap: wrap;
    }

    .btn {
        text-decoration: none;
        padding: 14px 25px;
        border-radius: 12px;
        color: white;
        font-weight: 600;
        transition: .3s;
    }

    .btn-primary {
        background: #2563EB;
    }

        .btn-primary:hover {
            background: #1D4ED8;
        }

    .btn-success {
        background: #10B981;
    }

        .btn-success:hover {
            background: #059669;
        }

    .section-title {
        margin-top: 40px;
        margin-bottom: 15px;
        font-size: 24px;
        font-weight: 700;
        color: #0F172A;
    }

    .campaign-box {
        background: white;
        padding: 25px;
        border-radius: 18px;
        box-shadow: 0 5px 20px rgba(0,0,0,.08);
    }

</style>

<div class="hero">

  
    <h1>Welcome Back</h1>

    <p>
        Thank you for supporting Give-AID.
        Together we can make a positive impact on communities.
    </p>
 

</div>
@if (TempData["Success"] != null)
{
    <div style="
            background:#DCFCE7;
            color:#166534;
            padding:15px;
            border-radius:10px;
            margin-bottom:20px;
            font-weight:600;">
        @TempData["Success"]
    </div>
}   

<div class="cards">

 
    <div class="card">
        <div class="card-title">Total Donations</div>
        <div class="card-value">@ViewBag.TotalDonations</div>
    </div>

    <div class="card">
        <div class="card-title">Volunteer Status</div>
        <div class="card-value">@ViewBag.VolunteerStatus</div>
    </div>

    <div class="card">
        <div class="card-title">Active Campaigns</div>
        <div class="card-value">@ViewBag.ActiveCampaigns</div>
    </div>

    <div class="card">
        <div class="card-title">Event Status</div>
        <div class="card-value">@ViewBag.EventStatus</div>
    </div>
   

</div>

<div class="actions">

    
    <a href="#" class="btn btn-primary">
        Donate Now
    </a>

    <a href="#" class="btn btn-success">
        Become Volunteer
    </a>
    

</div>

<div class="section-title">
    Featured Campaign
</div>

<div class="campaign-box">

    
    <h3>Help Flood Victims</h3>

    <br />

    <p>
        Support families affected by floods through donations,
        food supplies and emergency relief programs.
    </p>
   

</div>
