@model Give_AID.Models.User

@{
    Layout = "~/Views/Shared/User_Layout.cshtml";
}

<style>

    .profile-card {
        max-width: 850px;
        background: white;
        padding: 35px;
        border-radius: 20px;
        box-shadow: 0 10px 25px rgba(0,0,0,.08);
    }

    .profile-header {
        margin-bottom: 30px;
    }

    .profile-title {
        font-size: 32px;
        font-weight: 700;
        color: #0F172A;
    }

    .profile-sub {
        color: #64748B;
        margin-top: 5px;
    }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: #334155;
        }

    .form-control {
        width: 100%;
        padding: 14px;
        border: 1px solid #CBD5E1;
        border-radius: 12px;
        font-size: 15px;
    }

        .form-control:focus {
            outline: none;
            border-color: #2563EB;
        }

    .btn-save {
        background: linear-gradient(135deg,#2563EB,#10B981);
        color: white;
        border: none;
        padding: 14px 28px;
        border-radius: 12px;
        cursor: pointer;
        font-size: 16px;
        font-weight: 600;
    }

        .btn-save:hover {
            opacity: .9;
        }

</style>

<div class="profile-card">

    <div class="profile-header">
        <div class="profile-title">My Profile</div>
        <div class="profile-sub">
            Manage your account information.
        </div>
    </div>

    <form method="post">

        <input type="hidden" asp-for="Id" />

        <div class="form-group">
            <label>Name</label>
            <input asp-for="Name" class="form-control" />
        </div>

        <div class="form-group">
            <label>Email</label>
            <input asp-for="Email" class="form-control" />
        </div>

        <div class="form-group">
            <label>Password</label>
            <input asp-for="Password" class="form-control" />
        </div>

        <div class="form-group">
            <label>Contact Number</label>
            <input asp-for="Contact_No" class="form-control" />
        </div>

        <div class="form-group">
            <label>Address</label>
            <textarea asp-for="address"
                      class="form-control"
                      rows="4"></textarea>
        </div>

        <button type="submit" class="btn-save">
            Save Changes
        </button>

    </form>

</div>