@model List<Give_AID.Models.Donation>

@{
    Layout = "~/Views/Shared/User_Layout.cshtml";
}

<style>
    .history-card{
        background:white;
        padding:30px;
        border-radius:20px;
        box-shadow:0 10px 25px rgba(0,0,0,.08);
    }

    .page-title{
        font-size:30px;
        font-weight:700;
        color:#0F172A;
        margin-bottom:10px;
    }

    .page-sub{
        color:#64748B;
        margin-bottom:25px;
    }

    table{
        width:100%;
        border-collapse:collapse;
    }

    th{
        background:#0F172A;
        color:white;
        padding:15px;
        text-align:left;
    }

    td{
        padding:15px;
        border-bottom:1px solid #E2E8F0;
    }

    tr:hover{
        background:#F8FAFC;
    }
</style>

<div class="history-card">

    <div class="page-title">
        Donation History
    </div>
    @if (TempData["Success"] != null)
{
    <div style="
        background:#DCFCE7;
        color:#166534;
        padding:15px;
        border-radius:10px;
        margin-bottom:20px;
        font-weight:600;">
        ✔ @TempData["Success"]
    </div>
}

    <div class="page-sub">
        View all your previous donations.
    </div>

    <table>

        <thead>
            <tr>
                <th>ID</th>
                <th>Amount</th>
                <th>Date</th>
                <th>Payment Mode</th>
                <th>Purpose</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>Rs. @item.Amount</td>
                    <td>@item.Donation_Date</td>
                    <td>@item.Payment_Mode</td>
                    <td>@item.Purpose.Purpose_Name</td>
                </tr>
            }

        </tbody>

    </table>

</div>