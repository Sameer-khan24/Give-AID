@model List<Give_AID.Models.Event>

@{
    Layout = "~/Views/Shared/User_Layout.cshtml";
}

<style>

    .events-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(350px,1fr));
        gap: 25px;
    }

    .event-card {
        background: white;
        border-radius: 20px;
        padding: 25px;
        box-shadow: 0 10px 25px rgba(0,0,0,.08);
        transition: .3s;
    }

        .event-card:hover {
            transform: translateY(-5px);
        }

    .event-title {
        font-size: 24px;
        font-weight: 700;
        color: #0F172A;
        margin-bottom: 15px;
    }

    .event-info {
        margin-bottom: 10px;
        color: #475569;
    }

    .event-desc {
        margin-top: 15px;
        color: #64748B;
        line-height: 1.6;
    }

    .join-btn {
        display: inline-block;
        margin-top: 20px;
        background: linear-gradient(135deg,#2563EB,#10B981);
        color: white;
        text-decoration: none;
        padding: 12px 22px;
        border-radius: 12px;
        font-weight: 600;
    }

        .join-btn:hover {
            opacity: .9;
        }

    .page-title {
        font-size: 32px;
        font-weight: 700;
        margin-bottom: 25px;
        color: #0F172A;
    }

    .success-msg {
        background: #DCFCE7;
        color: #166534;
        padding: 15px;
        border-radius: 10px;
        margin-bottom: 20px;
        font-weight: 600;
    }

    .error-msg {
        background: #FEE2E2;
        color: #991B1B;
        padding: 15px;
        border-radius: 10px;
        margin-bottom: 20px;
        font-weight: 600;
    }

</style>

<div class="page-title">
    Upcoming Events
</div>

@if (TempData["Success"] != null)
{
    <div class="success-msg">
        ✔ @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="error-msg">
        ⚠ @TempData["Error"]
    </div>
}

<div class="events-grid">

    @foreach (var item in Model)
    {
        <div class="event-card">

            <div class="event-title">
                @item.Event_Name
            </div>

            <div class="event-info">
                📅 @item.Event_Date.ToShortDateString()
            </div>

            <div class="event-info">
                📍 @item.Location
            </div>

            <div class="event-desc">
                @item.Description
            </div>

            @if (ViewBag.JoinedEvents != null &&
                    ((List<int>)ViewBag.JoinedEvents).Contains(item.Id))
            {
                <span style="
                display:inline-block;
                margin-top:20px;
                background:#DCFCE7;
                color:#166534;
                padding:12px 22px;
                border-radius:12px;
                font-weight:600;">
                    ✔ Joined
                </span>
            }
            else
            {
                <a href="/Home/JoinEvent/@item.Id" class="join-btn">
                    Join Event
                </a>
            }

        </div>
    }

</div>