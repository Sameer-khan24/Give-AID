@model List<Give_AID.Models.Campaign>

@{
    Layout = "~/Views/Shared/Admin_Layout.cshtml";
}

<h2 style="margin-bottom:20px;">Campaign Management</h2>

<a href="/Admin/CreateCampaign"
   style="background:#2563EB;color:white;padding:10px 15px;
   text-decoration:none;border-radius:5px;">
    Add Campaign
</a>

<br />
<br />

<table class="table table-bordered">

    <thead>
        <tr>
            <th>ID</th>
            <th>Campaign Name</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th>Goal Amount</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Campaign_Name</td>
                <td>@item.Start_Date.ToShortDateString()</td>
                <td>@item.End_Date.ToShortDateString()</td>
                <td>@item.Goal_Amount</td>

                <td>
                    <a href="/Admin/EditCampaign/@item.Id">Edit</a> |
                    <a href="/Admin/DeleteCampaign/@item.Id"
                       onclick="return confirm('Are you sure?')">Delete</a>
                </td>
            </tr>
        }

    </tbody>

</table>